let producto:string='Yerba';let    precio   :number=1250.50   ;
let cantidad :number;
cantidad=3;


let subtotal:number=precio*cantidad;let descuento : number=subtotal/4+100-2*5;
let   total:number   =subtotal-descuento  ;
let mensaje:string="Compraste "+cantidad+" de "+producto;println(mensaje);
println("Total: "+total);println(   total/2   );
total=total+1;println(total);

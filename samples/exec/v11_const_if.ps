const nombre: string = "PrintScript";
const activo: boolean = true;
let intentos: number = 3;

if (activo) {
    println(nombre + " 1.1 está activo");
    let restantes: number = intentos - 1;
    println("Intentos restantes: " + restantes);
} else {
    println("Inactivo");
}

let terminado: boolean = false;
if (terminado) {
    println("no se imprime");
}
println("Fin");
